# Copy to ${XDG_CONFIG_HOME:-~/.config}/claude/secrets.map and list the secrets
# this machine needs. Format: ENV_VAR keystore-service-name
# Reference the variable in an MCP config as ${ENV_VAR}.
#
# macOS add:  security add-generic-password -U -a "$USER" -s my-service -w
# Linux add:  secret-tool store --label=my-service service my-service
#
# MY_MCP_TOKEN  my-mcp-token
