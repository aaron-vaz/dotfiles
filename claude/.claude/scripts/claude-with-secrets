#!/usr/bin/env bash
# claude-with-secrets — load per-machine secrets from the OS keystore, then exec claude.
# Must run inside the process tmux starts: tmux panes do not inherit the calling
# shell's exports, and `env VAR=secret claude` would leave the secret in the
# long-lived tmux client's argv (visible to `ps`).
#
# The secret list is per machine and never tracked. One "ENV_VAR service" pair per
# line; blank lines and # comments are ignored. See claude-with-secrets.map.example.
set -euo pipefail

map_file="${CLAUDE_SECRETS_MAP:-${XDG_CONFIG_HOME:-$HOME/.config}/claude/secrets.map}"

lookup() {
  local service="$1"
  if command -v security >/dev/null 2>&1; then
    security find-generic-password -s "$service" -a "$USER" -w 2>/dev/null || true
  elif command -v secret-tool >/dev/null 2>&1; then
    secret-tool lookup service "$service" 2>/dev/null || true
  fi
}

if [[ -r "$map_file" ]]; then
  while read -r var service _; do
    [[ -z "$var" || "$var" == \#* ]] && continue
    if [[ ! "$var" =~ ^[A-Za-z_][A-Za-z0-9_]*$ || -z "$service" ]]; then
      echo "claude-with-secrets: ignoring malformed line in $map_file" >&2
      continue
    fi
    # A variable already set by the caller wins, so a one-off override still works.
    [[ -n "${!var:-}" ]] && continue
    value="$(lookup "$service")"
    if [[ -z "$value" ]]; then
      echo "claude-with-secrets: keystore item '$service' missing, $var not set" >&2
      continue
    fi
    export "$var=$value"
  done < "$map_file"
fi

exec claude "$@"
