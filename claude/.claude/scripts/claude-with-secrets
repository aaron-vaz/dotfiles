#!/usr/bin/env bash
# claude-with-secrets — load MCP secrets from the macOS Keychain, then exec claude.
# Must run inside the process tmux starts: tmux panes do not inherit the calling
# shell's exports, and `env VAR=secret claude` would leave the secret in the
# long-lived tmux client's argv (visible to `ps`).
set -euo pipefail

# ENV_VAR:keychain-service (raw token values, no "Bearer " prefix)
SECRETS=(
  "TESSERAE_MCP_TOKEN:tesserae-mcp-token"
  "HOMEASSISTANT_MCP_TOKEN:homeassistant-mcp-token"
)

for entry in "${SECRETS[@]}"; do
  var="${entry%%:*}"
  service="${entry#*:}"
  # A variable already set by the caller wins, so a one-off override still works.
  if [[ -n "${!var:-}" ]]; then
    continue
  fi
  value="$(security find-generic-password -s "$service" -a "$USER" -w 2>/dev/null || true)"
  if [[ -z "$value" ]]; then
    echo "claude-with-secrets: Keychain item '$service' missing, $var not set" >&2
    continue
  fi
  export "$var=$value"
done

exec claude "$@"
