# Runtime state (regenerated per-machine)
claude.json
command-log.txt
tool-audit.log

# Knowledge base index (auto-generated by search-kb.sh — contains private
# entries' descriptions, so it must never be tracked in this public repo)
kb/index.tsv

# Private KB store. It lives at ~/.claude/kb/private/, outside this repo, and is
# never symlinked in — that, not this line, is what keeps it out. This is a
# belt-and-braces guard in case the directory is ever recreated inside the repo.
kb/private/

# Sessions (ephemeral per-session state)
sessions/*.md
sessions/.rename-request

# Logs
logs/

# OS
.DS_Store
