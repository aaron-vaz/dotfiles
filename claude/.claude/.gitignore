sessions/*.md
sessions/.rename-request
sessions/.quality-check-last-run

# Learnings (runtime error logs)
learnings/*.log
learnings/.last-analyzed-*

# Costs (auto-accumulated by statusline)
costs/

# Logs
logs/

# OS
.DS_Store
