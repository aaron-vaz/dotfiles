{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "go": {
      "name": "go"
    }
  },
  "model": "opencode-go/deepseek-v4-flash",
  "agent": {
    "build": {
      "mode": "primary",
      "model": "opencode-go/kimi-k2.5",
      "description": "Default coding mode. Use for 90% of work: editing, testing, debugging.",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "allow"
      }
    },
    "plan": {
      "mode": "primary",
      "model": "opencode-go/qwen3.7-max",
      "description": "Architecture and design mode. Read-only reasoning for complex planning before implementation.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "allow"
      }
    },
    "review": {
      "mode": "primary",
      "model": "opencode-go/kimi-k2.6",
      "description": "Code review mode. Read-only analysis of existing code.",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "webfetch": "deny",
        "todowrite": "deny"
      }
    }
  },
  "plugin": [
    "cc-safety-net",
    "envsitter-guard",
    "opencode-notify",
    "opencode-worktree",
    "tokenscope",
    "./plugins/caveman/plugin.js"
  ]
}
