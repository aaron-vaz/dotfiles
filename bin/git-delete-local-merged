#!/bin/sh
#
# Delete all local branches that have been merged into HEAD, except the current one and
# master, main and develop. Stolen from our favorite @tekkub:
#
#   https://plus.google.com/115587336092124934674/posts/dXsagsvLakJ

git branch --merged | grep -vE '^\*|^[[:space:]]*(master|main|develop)$' | while read -r branch; do
  git branch -d "$branch"
done
